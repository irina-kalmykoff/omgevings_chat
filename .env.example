# Copy to .env and adjust. .env is gitignored; never commit real credentials.
# Every value below except OPENAI_API_KEY has a working default; uncomment to change.

# LLM step (omgkg ask); also used by the prototype's deontic_extract.py / derogation_probe.py
OPENAI_API_KEY=
# OMGKG_LLM_MODEL=gpt-4o

# RAG step: the collection `omgkg import-snapshot` restored into the local Qdrant
OMGKG_QDRANT_COLLECTION=
# OMGKG_QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# OmgevingsChat checkout and its settings (OPENAI/COHERE keys), used by the bridge
# OMGKG_PLATFORM_DIR=../omgevingschat-platform
# OMGKG_PLATFORM_ENV=../omgevingschat-platform/apps/web/.env.local
# OMGKG_SOURCE_ID=/akn/nl/act/gm0935/2020/omgevingsplan
# OMGKG_METADATA_SCHEMA=v2

# KG step: Neo4j from docker-compose.yml (local development database)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=testpassword

# omgkg serve-kg: the key OmgevingsChat sends as YDIGITAL_KG_API_KEY
# OMGKG_KG_API_KEY=
